{
  "name": "تحويل نصوص لصوت",
  "steps": [
    {
      "id": "topics",
      "action": "read_json",
      "file": "topics.json",
      "label": "قراءة السكريبتات من topics.json"
    },
    {
      "id": "scripts",
      "action": "topics_to_markers",
      "input": "{topics}",
      "marker_prefix": "SCRIPT",
      "label": "تحويل topics.json لتنسيق MG Ranner"
    },
    {
      "id": "audio",
      "action": "tts_multi",
      "input": "{scripts}",
      "marker_prefix": "SCRIPT",
      "label": "تحويل النصوص لصوت"
    }
  ]
}
