{
  "name": "إنشاء قصة",
  "steps": [
    {
      "id": "instructions",
      "action": "read_input",
      "file": "instructions.txt",
      "label": "قراءة التعليمات"
    },
    {
      "id": "topics",
      "action": "read_input",
      "file": "topics.json",
      "label": "قراءة العناوين"
    },
    {
      "id": "prompt",
      "action": "template",
      "text": "{instructions}\n\n---\n\nقائمة العناوين المطلوب إنشاء قصص لها:\n\n{topics}",
      "label": "تجميع البرومبت"
    },
    {
      "id": "stories",
      "action": "generate",
      "input": "{prompt}",
      "max_tokens": 16000,
      "temperature": 0.7,
      "label": "توليد القصص"
    },
    {
      "id": "formatted",
      "action": "format_text",
      "input": "{stories}",
      "color_words": ["بس", "ده", "دي", "دى", "دول"],
      "spaces_after_punctuation": 5,
      "label": "تنسيق النص"
    },
    {
      "id": "docx",
      "action": "save_docx",
      "input": "{formatted}",
      "save_as": "stories_output.docx",
      "font_size": 14,
      "label": "حفظ ملف Word"
    }
  ]
}
