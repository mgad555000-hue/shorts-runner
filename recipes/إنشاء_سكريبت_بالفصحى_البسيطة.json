{
  "name": "إنشاء سكريبت بالفصحى البسيطة",
  "steps": [
    {
      "id": "instructions",
      "action": "read_input",
      "file": "instructions.txt",
      "label": "قراءة التعليمات"
    },
    {
      "id": "topics",
      "action": "read_input",
      "file": "topics.json",
      "label": "قراءة العناوين"
    },
    {
      "id": "memory_bank",
      "action": "read_input",
      "file": "memory_bank.json",
      "label": "قراءة بنك الذاكرة"
    },
    {
      "id": "topics_markers",
      "action": "topics_to_markers",
      "input": "{topics}",
      "marker_prefix": "SCRIPT",
      "label": "تحويل العناوين لماركرز (يفعّل per-marker generation)"
    },
    {
      "id": "prompt",
      "action": "template",
      "text": "{instructions}\n\n---\n\nبنك ذاكرة الفيديوهات السابقة (ممنوع تكرار محتواه):\n\n{memory_bank}\n\n---\n\nقائمة العناوين المطلوب إنشاء سكريبتات لها (كل عنوان داخل ماركر منفصل):\n\n{topics_markers}",
      "label": "تجميع البرومبت"
    },
    {
      "id": "scripts",
      "action": "generate",
      "input": "{prompt}",
      "cache_content": "{instructions}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 16000,
      "temperature": 0.3,
      "thinking_level": "high",
      "max_workers": 30,
      "label": "توليد السكريبتات (per-marker × 30 parallel + cache)"
    },
    {
      "id": "update_memory",
      "action": "update_memory_bank",
      "input": "{scripts}",
      "topics": "{topics}",
      "file": "memory_bank.json",
      "max_entries": 100,
      "label": "تحديث بنك الذاكرة أوتوماتيكياً"
    },
    {
      "id": "tashkeel_rules",
      "action": "read_input",
      "file": "tashkeel_instructions.txt",
      "label": "قراءة تعليمات التشكيل"
    },
    {
      "id": "tashkeel_prompt",
      "action": "template",
      "text": "{tashkeel_rules}\n\n---\n\nالنصوص المطلوب تشكيلها:\n\n{scripts}",
      "label": "تجميع برومبت التشكيل"
    },
    {
      "id": "tashkeel_scripts",
      "action": "generate",
      "input": "{tashkeel_prompt}",
      "cache_content": "{tashkeel_rules}",
      "model": "gemini-2.5-pro",
      "max_tokens": 32000,
      "temperature": 0.3,
      "thinking_level": "low",
      "max_workers": 30,
      "label": "تشكيل السكريبتات (per-marker × 30 + 2.5 Pro + low + cache)"
    },
    {
      "id": "formatted",
      "action": "format_text",
      "input": "{tashkeel_scripts}",
      "color_words": ["الكلا", "النفرونات", "الكبيبات", "البودوسيت", "الكرياتينين", "الالبومين"],
      "spaces_after_punctuation": 5,
      "label": "تنسيق النص"
    },
    {
      "id": "docx",
      "action": "save_docx",
      "input": "{formatted}",
      "save_as": "scripts_output.docx",
      "font_name": "Simplified Arabic",
      "font_size": 28,
      "line_spacing": 1.0,
      "label": "حفظ ملف Word"
    },
    {
      "id": "topics_json",
      "action": "scripts_to_topics_json",
      "input": "{tashkeel_scripts}",
      "marker_prefix": "SCRIPT",
      "save_as": "topics.json",
      "label": "تصدير topics.json للوصفات الجاية"
    }
  ]
}