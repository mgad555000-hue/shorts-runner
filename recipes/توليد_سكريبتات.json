{
  "name": "توليد سكريبتات",
  "steps": [
    {
      "id": "instructions",
      "action": "read_input",
      "file": "instructions.txt",
      "label": "قراءة التعليمات"
    },
    {
      "id": "topics",
      "action": "read_input",
      "file": "topics.json",
      "label": "قراءة العناوين"
    },
    {
      "id": "prompt",
      "action": "template",
      "text": "{instructions}\n\n---\n\nقائمة العناوين المطلوب إنشاء سكريبتات لها:\n\n{topics}",
      "label": "تجميع البرومبت"
    },
    {
      "id": "scripts",
      "action": "generate",
      "input": "{prompt}",
      "max_tokens": 32000,
      "temperature": 0.7,
      "label": "توليد السكريبتات"
    },
    {
      "id": "intros_raw",
      "action": "split_script",
      "input": "{scripts}",
      "part": "intros",
      "label": "استخراج المقدمات"
    },
    {
      "id": "texts_raw",
      "action": "split_script",
      "input": "{scripts}",
      "part": "texts",
      "label": "استخراج النصوص"
    },
    {
      "id": "intros_formatted",
      "action": "format_text",
      "input": "{intros_raw}",
      "color_words": ["بس", "ده", "دي", "دى", "دول"],
      "spaces_after_punctuation": 5,
      "label": "تنسيق المقدمات"
    },
    {
      "id": "docx_intros",
      "action": "save_docx",
      "input": "{intros_formatted}",
      "save_as": "intros_output.docx",
      "font_size": 14,
      "label": "حفظ المقدمات"
    },
    {
      "id": "docx_texts",
      "action": "save_docx",
      "input": "{texts_raw}",
      "save_as": "texts_output.docx",
      "font_size": 14,
      "label": "حفظ النصوص"
    }
  ]
}
