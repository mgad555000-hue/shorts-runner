{
  "name": "توليد سكريبتات",
  "steps": [
    {
      "id": "instructions",
      "action": "read_input",
      "file": "instructions.txt",
      "label": "قراءة التعليمات"
    },
    {
      "id": "topics",
      "action": "read_input",
      "file": "topics.json",
      "label": "قراءة العناوين"
    },
    {
      "id": "memory_bank",
      "action": "read_input",
      "file": "memory_bank.json",
      "label": "قراءة بنك الذاكرة"
    },
    {
      "id": "prompt",
      "action": "template",
      "text": "{instructions}\n\n---\n\nبنك ذاكرة الفيديوهات السابقة (ممنوع تكرار محتواه):\n\n{memory_bank}\n\n---\n\nقائمة العناوين المطلوب إنشاء سكريبتات لها:\n\n{topics}",
      "label": "تجميع البرومبت"
    },
    {
      "id": "scripts",
      "action": "generate",
      "input": "{prompt}",
      "cache_content": "{instructions}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 65536,
      "temperature": 0.5,
      "thinking_level": "high",
      "label": "توليد السكريبتات (Gemini 3.1 Pro Preview + thinking=high + cache)"
    },
    {
      "id": "update_memory",
      "action": "update_memory_bank",
      "input": "{scripts}",
      "topics": "{topics}",
      "file": "memory_bank.json",
      "max_entries": 100,
      "label": "تحديث بنك الذاكرة أوتوماتيكياً"
    },
    {
      "id": "intros_raw",
      "action": "split_script",
      "input": "{scripts}",
      "part": "intros",
      "label": "استخراج المقدمات"
    },
    {
      "id": "texts_raw",
      "action": "split_script",
      "input": "{scripts}",
      "part": "texts",
      "label": "استخراج النصوص"
    },
    {
      "id": "tashkeel_rules",
      "action": "read_input",
      "file": "tashkeel_instructions.txt",
      "label": "قراءة تعليمات تشكيل المقدمات"
    },
    {
      "id": "tashkeel_prompt",
      "action": "template",
      "text": "{tashkeel_rules}\n\n---\n\nالنصوص المطلوب تشكيلها:\n\n{intros_raw}",
      "label": "تجميع برومبت تشكيل المقدمات"
    },
    {
      "id": "tashkeel_intros",
      "action": "generate",
      "input": "{tashkeel_prompt}",
      "cache_content": "{tashkeel_rules}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 15000,
      "temperature": 0.1,
      "thinking_budget": 1024,
      "label": "تشكيل المقدمات (Gemini 3.1 Pro + thinking_budget=1024 + cache)"
    },
    {
      "id": "intros_restored",
      "action": "restore_truncated_words",
      "input": "{tashkeel_intros}",
      "original": "{intros_raw}",
      "mode": "intros",
      "label": "Layer 2 — إصلاح ميكانيكي للكلمات المبتورة (ة المحذوفة)"
    },
    {
      "id": "intros_validated",
      "action": "validate_intros_truncation",
      "input": "{intros_restored}",
      "original": "{intros_raw}",
      "label": "كشف المقدمات اللي لسه فيها كلمات مبتورة"
    },
    {
      "id": "intros_regenerated",
      "action": "regenerate_failed_intros",
      "input": "{intros_validated}",
      "original": "{intros_raw}",
      "failed_ref": "{intros_validated_failed}",
      "instructions": "{tashkeel_rules}",
      "model": "gemini-3.1-pro-preview",
      "temperature": 0.1,
      "thinking_budget": 1024,
      "max_tokens": 15000,
      "max_attempts": 3,
      "label": "Layer 1 — إعادة تشكيل السكريبتات الفاشلة (max 3 attempts)"
    },
    {
      "id": "intros_restored_final",
      "action": "restore_truncated_words",
      "input": "{intros_regenerated}",
      "original": "{intros_raw}",
      "mode": "intros",
      "label": "إصلاح ميكانيكي بعد إعادة التوليد"
    },
    {
      "id": "intros_final_validated",
      "action": "validate_intros_truncation",
      "input": "{intros_restored_final}",
      "original": "{intros_raw}",
      "label": "تأكيد نهائي: مفيش كلمات مبتورة"
    },
    {
      "id": "assert_intros_clean",
      "action": "assert_no_failures",
      "input": "{intros_final_validated}",
      "failed_refs": ["intros_final_validated_failed", "intros_regenerated_permanently_failed"],
      "label": "Layer 3 — حماية: منع حفظ مقدمات فيها كلمات مبتورة"
    },
    {
      "id": "intros_auto_fixed",
      "action": "auto_fix_text",
      "input": "{assert_intros_clean}",
      "label": "إصلاح ميكانيكي (Tatweel + مسافات + كلمات طبية)"
    },
    {
      "id": "intros_formatted",
      "action": "format_text",
      "input": "{intros_auto_fixed}",
      "color_words": ["الكلا", "النفرونات", "الكبيبات", "البودوسيت", "الكرياتينين", "الالبومين"],
      "spaces_after_punctuation": 5,
      "label": "تنسيق المقدمات"
    },
    {
      "id": "docx_intros",
      "action": "save_docx",
      "input": "{intros_formatted}",
      "save_as": "intros_output.docx",
      "font_name": "Simplified Arabic",
      "font_size": 28,
      "line_spacing": 1.0,
      "label": "حفظ المقدمات (Simplified Arabic 28pt line-spacing 1.0)"
    },
    {
      "id": "texts_clean",
      "action": "clean_text",
      "input": "{texts_raw}",
      "label": "تنظيف النصوص"
    },
    {
      "id": "tashkeel_texts_rules",
      "action": "read_input",
      "file": "tashkeel_texts_instructions.txt",
      "label": "قراءة تعليمات تشكيل النصوص"
    },
    {
      "id": "tashkeel_texts_prompt",
      "action": "template",
      "text": "{tashkeel_texts_rules}\n\n---\n\nالنصوص المطلوب تشكيلها (الفصحى):\n\n{texts_clean}",
      "label": "تجميع برومبت تشكيل النصوص"
    },
    {
      "id": "texts_tashkeeled",
      "action": "generate",
      "input": "{tashkeel_texts_prompt}",
      "cache_content": "{tashkeel_texts_rules}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 15000,
      "temperature": 0.1,
      "thinking_budget": 1024,
      "label": "تشكيل النصوص (Gemini 3.1 Pro + thinking_budget=1024 + cache)"
    },
    {
      "id": "texts_restored",
      "action": "restore_truncated_words",
      "input": "{texts_tashkeeled}",
      "original": "{texts_clean}",
      "label": "إصلاح الكلمات المبتورة (مطابقة بالمدخل)"
    },
    {
      "id": "texts_stripped",
      "action": "strip_last_letter_diacritic",
      "input": "{texts_restored}",
      "label": "إزالة حركة الحرف الأخير من كل كلمة"
    },
    {
      "id": "texts_auto_fixed",
      "action": "auto_fix_text",
      "input": "{texts_stripped}",
      "label": "إصلاح ميكانيكي (Tatweel + مسافات + كلمات طبية)"
    },
    {
      "id": "texts_validated",
      "action": "validate_texts",
      "input": "{texts_auto_fixed}",
      "min_words": 70,
      "max_words": 130,
      "expected_parts": 4,
      "label": "مراجعة النصوص"
    },
    {
      "id": "texts_regenerated",
      "action": "regenerate_failed",
      "input": "{texts_validated}",
      "failed_ref": "{texts_validated_failed}",
      "instructions": "{tashkeel_texts_rules}",
      "model": "gemini-3.1-pro-preview",
      "temperature": 0.1,
      "thinking_budget": 1024,
      "max_tokens": 15000,
      "label": "إعادة تشكيل الفاشل (Gemini 3.1 Pro + thinking_budget=1024)"
    },
    {
      "id": "texts_final",
      "action": "validate_texts",
      "input": "{texts_regenerated}",
      "min_words": 70,
      "max_words": 130,
      "expected_parts": 4,
      "label": "تأكيد نهائي"
    },
    {
      "id": "assert_texts_clean",
      "action": "assert_no_failures",
      "input": "{texts_final}",
      "failed_refs": ["texts_final_failed", "texts_regenerated_permanently_failed"],
      "label": "حماية: منع حفظ مواضيع فاشلة"
    },
    {
      "id": "docx_texts",
      "action": "save_docx",
      "input": "{assert_texts_clean}",
      "save_as": "texts_output.docx",
      "font_name": "Simplified Arabic",
      "font_size": 28,
      "line_spacing": 1.0,
      "label": "حفظ النصوص (Simplified Arabic 28pt line-spacing 1.0)"
    },
    {
      "id": "topics_json",
      "action": "scripts_to_topics_json",
      "input": "{texts_raw}",
      "marker_prefix": "SCRIPT",
      "save_as": "topics.json",
      "label": "تصدير topics.json للوصفات الجاية"
    }
  ]
}
