{
  "name": "توليد سكريبتات",
  "steps": [
    {
      "id": "instructions",
      "action": "read_input",
      "file": "instructions.txt",
      "label": "قراءة التعليمات"
    },
    {
      "id": "topics",
      "action": "read_input",
      "file": "topics.json",
      "label": "قراءة العناوين"
    },
    {
      "id": "prompt",
      "action": "template",
      "text": "{instructions}\n\n---\n\nقائمة العناوين المطلوب إنشاء سكريبتات لها:\n\n{topics}",
      "label": "تجميع البرومبت"
    },
    {
      "id": "scripts",
      "action": "generate",
      "input": "{prompt}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 65536,
      "temperature": 0.5,
      "thinking_level": "high",
      "label": "توليد السكريبتات"
    },
    {
      "id": "intros_raw",
      "action": "split_script",
      "input": "{scripts}",
      "part": "intros",
      "label": "استخراج المقدمات"
    },
    {
      "id": "texts_raw",
      "action": "split_script",
      "input": "{scripts}",
      "part": "texts",
      "label": "استخراج النصوص"
    },
    {
      "id": "tashkeel_rules",
      "action": "read_input",
      "file": "tashkeel_instructions.txt",
      "label": "قراءة تعليمات التشكيل"
    },
    {
      "id": "tashkeel_prompt",
      "action": "template",
      "text": "{tashkeel_rules}\n\n---\n\nالنصوص المطلوب تشكيلها:\n\n{intros_raw}",
      "label": "تجميع برومبت التشكيل"
    },
    {
      "id": "tashkeel_intros",
      "action": "generate",
      "input": "{tashkeel_prompt}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 65536,
      "temperature": 0.1,
      "thinking_level": "high",
      "label": "تشكيل المقدمات"
    },
    {
      "id": "intros_formatted",
      "action": "format_text",
      "input": "{tashkeel_intros}",
      "color_words": ["بس", "ده", "دي", "دى", "دول"],
      "spaces_after_punctuation": 5,
      "label": "تنسيق المقدمات"
    },
    {
      "id": "docx_intros",
      "action": "save_docx",
      "input": "{intros_formatted}",
      "save_as": "intros_output.docx",
      "font_size": 14,
      "label": "حفظ المقدمات"
    },
    {
      "id": "texts_clean",
      "action": "clean_text",
      "input": "{texts_raw}",
      "label": "تنظيف النصوص"
    },
    {
      "id": "texts_validated",
      "action": "validate_texts",
      "input": "{texts_clean}",
      "min_words": 70,
      "max_words": 130,
      "expected_parts": 4,
      "label": "مراجعة النصوص"
    },
    {
      "id": "texts_regenerated",
      "action": "regenerate_failed",
      "input": "{texts_validated}",
      "failed_ref": "{texts_validated_failed}",
      "instructions": "{instructions}",
      "model": "gemini-3.1-pro-preview",
      "temperature": 0.3,
      "thinking_level": "low",
      "max_tokens": 16000,
      "label": "إعادة توليد الفاشل"
    },
    {
      "id": "texts_final",
      "action": "validate_texts",
      "input": "{texts_regenerated}",
      "min_words": 70,
      "max_words": 130,
      "expected_parts": 4,
      "label": "تأكيد نهائي"
    },
    {
      "id": "docx_texts",
      "action": "save_docx",
      "input": "{texts_final}",
      "save_as": "texts_output.docx",
      "font_size": 14,
      "label": "حفظ النصوص"
    },
    {
      "id": "topics_json",
      "action": "scripts_to_topics_json",
      "input": "{texts_raw}",
      "marker_prefix": "SCRIPT",
      "save_as": "topics.json",
      "label": "تصدير topics.json للوصفات الجاية"
    }
  ]
}
