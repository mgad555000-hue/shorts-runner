{
  "name": "إنشاء سكريبت بالعامية",
  "steps": [
    {
      "id": "instructions",
      "action": "read_input",
      "file": "instructions.txt",
      "label": "قراءة التعليمات"
    },
    {
      "id": "topics",
      "action": "read_input",
      "file": "topics.json",
      "label": "قراءة العناوين"
    },
    {
      "id": "prompt",
      "action": "template",
      "text": "{instructions}\n\n---\n\nقائمة العناوين المطلوب إنشاء سكريبتات لها:\n\n{topics}",
      "label": "تجميع البرومبت"
    },
    {
      "id": "scripts",
      "action": "generate",
      "input": "{prompt}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 16000,
      "temperature": 0.7,
      "thinking_level": "low",
      "label": "توليد السكريبتات"
    },
    {
      "id": "tashkeel_rules",
      "action": "read_input",
      "file": "tashkeel_instructions.txt",
      "label": "قراءة تعليمات التشكيل"
    },
    {
      "id": "tashkeel_prompt",
      "action": "template",
      "text": "{tashkeel_rules}\n\n---\n\nالنصوص المطلوب تشكيلها:\n\n{scripts}",
      "label": "تجميع برومبت التشكيل"
    },
    {
      "id": "tashkeel_scripts",
      "action": "generate",
      "input": "{tashkeel_prompt}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 32000,
      "temperature": 0.3,
      "thinking_level": "low",
      "label": "تشكيل السكريبتات"
    },
    {
      "id": "formatted",
      "action": "format_text",
      "input": "{tashkeel_scripts}",
      "color_words": ["بس", "ده", "دي", "دى", "دول"],
      "spaces_after_punctuation": 5,
      "label": "تنسيق النص"
    },
    {
      "id": "docx",
      "action": "save_docx",
      "input": "{formatted}",
      "save_as": "scripts_output.docx",
      "font_size": 14,
      "label": "حفظ ملف Word"
    },
    {
      "id": "topics_json",
      "action": "scripts_to_topics_json",
      "input": "{tashkeel_scripts}",
      "marker_prefix": "SCRIPT",
      "save_as": "topics.json",
      "label": "تصدير topics.json للوصفات الجاية"
    }
  ]
}