{
  "name": "توليد نصوص من مقدمات",
  "steps": [
    {
      "id": "instructions",
      "action": "read_input",
      "file": "instructions.txt",
      "label": "قراءة التعليمات"
    },
    {
      "id": "intros",
      "action": "read_docx",
      "file": "intros_output.docx",
      "reconstruct_markers": true,
      "label": "قراءة المقدمات"
    },
    {
      "id": "intros_filtered",
      "action": "filter_by_topics",
      "input": "{intros}",
      "label": "فلترة المقدمات حسب TOPIC_IDS"
    },
    {
      "id": "prompt",
      "action": "template",
      "text": "{instructions}\n\n---\n\nالمقدمات المطلوب كتابة نصوص فصحى لها:\n\n{intros_filtered}",
      "label": "تجميع البرومبت"
    },
    {
      "id": "texts_raw",
      "action": "generate",
      "input": "{prompt}",
      "model": "gemini-3.1-pro-preview",
      "max_tokens": 32000,
      "temperature": 0.3,
      "thinking_level": "low",
      "label": "توليد النصوص"
    },
    {
      "id": "texts_stripped",
      "action": "strip_last_letter_diacritic",
      "input": "{texts_raw}",
      "label": "إزالة حركة الحرف الأخير من كل كلمة"
    },
    {
      "id": "texts_clean",
      "action": "clean_text",
      "input": "{texts_stripped}",
      "label": "تنظيف النصوص"
    },
    {
      "id": "texts_auto_fixed",
      "action": "auto_fix_text",
      "input": "{texts_clean}",
      "label": "إصلاح ميكانيكي (Tatweel + مسافات + كلمات طبية)"
    },
    {
      "id": "texts_validated",
      "action": "validate_texts",
      "input": "{texts_auto_fixed}",
      "min_words": 70,
      "max_words": 130,
      "expected_parts": 4,
      "label": "مراجعة النصوص"
    },
    {
      "id": "texts_regenerated",
      "action": "regenerate_failed",
      "input": "{texts_validated}",
      "failed_ref": "{texts_validated_failed}",
      "instructions": "{instructions}",
      "model": "gemini-3.1-pro-preview",
      "temperature": 0.3,
      "thinking_level": "low",
      "max_tokens": 16000,
      "label": "إعادة توليد الفاشل"
    },
    {
      "id": "texts_final",
      "action": "validate_texts",
      "input": "{texts_regenerated}",
      "min_words": 70,
      "max_words": 130,
      "expected_parts": 4,
      "label": "تأكيد نهائي"
    },
    {
      "id": "assert_texts_clean",
      "action": "assert_no_failures",
      "input": "{texts_final}",
      "failed_refs": ["texts_final_failed", "texts_regenerated_permanently_failed"],
      "label": "حماية: منع حفظ مواضيع فاشلة"
    },
    {
      "id": "docx_texts",
      "action": "save_docx",
      "input": "{assert_texts_clean}",
      "save_as": "texts_output.docx",
      "font_size": 14,
      "label": "حفظ النصوص"
    }
  ]
}
